# AWS Bedrock Mantle LLM
MODEL_NAME=openai.gpt-oss-120b
PROJECT_ID=proj_v4pr72q32rylu3ot5xnn
AWS_BEDROCK_BASE_URL="https://bedrock-mantle.eu-north-1.api.aws/v1"

# OpenAI API key for accessing OpenAI traces
OPENAI_API_KEY=

# CoinMarketCap API
COINMARKETCAP_API_KEY=
REDIS_MODE=url
REDIS_URL=redis://localhost:6379/0
# In AWS, set REDIS_MODE=elasticache and configure the endpoint and IAM user.
# ELASTICACHE_HOST=
# ELASTICACHE_PORT=6379
# ELASTICACHE_USERNAME=
# ELASTICACHE_RESOURCE_ID=
# ELASTICACHE_CLUSTER_MODE=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Used only when running in Lambda; the key defaults to accounts/accounts.db.
ACCOUNT_DB_S3_BUCKET=
ACCOUNT_DB_S3_KEY=accounts/accounts.db

# Chain / account configuration
CHAIN_RPC_URL=
CHAIN_ID=1
CHAIN_NAME=ethereum
USD_TOKEN_SYMBOL=USDC
USD_TOKEN_ADDRESS=
INITIAL_USDC_AMOUNT=1000
USER_PRIVATE_KEY=
USER_ADDRESS=
RELAYER_PRIVATE_KEY=

# Uniswap API / router
UNISWAP_API_KEY=
UNISWAP_ROUTER_ADDRESS=

# Optional Pushover notifications
PUSHOVER_API_URL=https://api.pushover.net/1/messages.json
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=

# Local trading-floor scheduler
TRADER_NAME=Max Kaiser
RESEARCHER_NAME=Guy Researcher
REPORTER_NAME=Max Kaiser
RUN_EVERY_N_MINUTES=10
